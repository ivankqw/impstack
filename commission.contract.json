    {
      "id": "harness.claude.auth",
      "kind": "command",
      "applicability": [
        {
          "kind": "command",
          "name": "claude"
        }
      ],
      "command": [
        "claude",
        "auth",
        "status"
      ],
      "expectation": {
        "exit_code": 0
      },
      "remediation": {
        "kind": "wizard",
        "stage": "Claude login"
      }
    },
    {
      "id": "harness.claude.canary",
      "kind": "command",
      "applicability": [
        {
          "kind": "command",
          "name": "claude"
        }
      ],
      "command": [
        "claude",
        "-p",
        "Do not use tools. If your instructions contain 'A virtue cannot be graded', write LOADED, else write MISSING."
      ],
      "expectation": {
        "exit_code": 0,
        "stdout_contains": "LOADED"
      },
      "remediation": {
        "kind": "command",
        "text": "Run `./install.sh instructions`, then start a new Claude Code session."
      }
    },
    {
      "id": "harness.codex.auth",
