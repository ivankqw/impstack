#!/usr/bin/env python3
"""Keep third-party skills consistent across machines.

Commands:
  normalize  Write skills-catalog.json from the skills CLI lockfile.
  run        Pull, restore, update, normalize, validate, commit, and push.
  check      Validate the catalog against installed skills without writes.
  schedule   Print a macOS launchd plist and Linux 09:00 daily crontab line.
"""

from __future__ import annotations

import argparse
import fnmatch
import hashlib
import json
import os
import pathlib
import platform
import re
import shlex
import shutil
import socket
import subprocess
import sys
from dataclasses import dataclass
from typing import Any
from xml.sax.saxutils import escape

CATALOG_FIELDS = ("source", "sourceType", "sourceUrl", "skillPath")


def repo_root() -> pathlib.Path:
    configured = os.environ.get("IMPSTACK_DIR")
    if configured:
        return pathlib.Path(configured)
    return pathlib.Path(__file__).resolve().parent.parent


@dataclass(frozen=True)
class SkillStatePaths:
    shared: pathlib.Path
    lock: pathlib.Path
    xdg_state_home: pathlib.Path | None
    native_lock: pathlib.Path


def skill_state_paths() -> SkillStatePaths:
    home = pathlib.Path.home().resolve()
    raw_xdg = os.environ.get("XDG_STATE_HOME")
    xdg_state_home = pathlib.Path(raw_xdg).expanduser().resolve() if raw_xdg else None
    shared = pathlib.Path(os.environ.get("SHARED_SKILLS", home / ".agents" / "skills"))
    native_lock = (
        xdg_state_home / "skills" / ".skill-lock.json"
        if xdg_state_home
        else home / ".agents" / ".skill-lock.json"
    )
    configured_lock = os.environ.get("SKILLS_LOCK_FILE")
    if configured_lock:
        lock = pathlib.Path(configured_lock)
    else:
        lock = native_lock
    return SkillStatePaths(
        shared=shared.expanduser().resolve(),
        lock=lock.expanduser().resolve(),
        xdg_state_home=xdg_state_home,
        native_lock=native_lock,
    )


def live_lock_path() -> pathlib.Path:
    path = skill_state_paths().lock
    if path.is_file():
        return path
    raise FileNotFoundError(f"skills CLI lockfile not found at {path}")


def load_json(path: pathlib.Path) -> Any:
    try:
        return json.loads(path.read_text())
    except json.JSONDecodeError as error:
        raise ValueError(f"invalid JSON in {path}: {error}") from error


def load_ignore_patterns(root: pathlib.Path) -> tuple[str, ...]:
    path = root / "skills-ignore.txt"
    if not path.is_file():
        return ()
    return tuple(
        line
        for raw_line in path.read_text().splitlines()
        if (line := raw_line.strip()) and not line.startswith("#")
    )


def is_ignored(name: str, patterns: tuple[str, ...]) -> bool:
    return any(fnmatch.fnmatchcase(name, pattern) for pattern in patterns)


def normalized_catalog(
    lock: object,
    ignore_patterns: tuple[str, ...] = (),
) -> dict[str, dict[str, dict[str, str]]]:
    if not isinstance(lock, dict) or not isinstance(lock.get("skills"), dict):
        raise ValueError("live lockfile must contain a skills object")
    raw_skills = lock["skills"]
    if not all(
        isinstance(name, str) and isinstance(entry, dict)
        for name, entry in raw_skills.items()
    ):
        raise ValueError("live lockfile contains an invalid skill entry")
    skills: dict[str, dict[str, str]] = {}
    for name in sorted(raw_skills):
        if is_ignored(name, ignore_patterns):
            continue
        entry = raw_skills[name]
        missing = [
            field
            for field in CATALOG_FIELDS
            if not isinstance(entry.get(field), str) or not entry[field]
        ]
        if missing:
            raise ValueError(f"live lock entry {name} is missing: {', '.join(missing)}")
        skills[name] = {field: entry[field] for field in CATALOG_FIELDS}
    return {"skills": dict(sorted(skills.items()))}


def normalize(root: pathlib.Path, *, allow_removals: bool = False) -> None:
    catalog = root / "skills-catalog.json"
    ignore_patterns = load_ignore_patterns(root)
    existing = load_catalog(root) if catalog.is_file() else {}
    normalized = normalized_catalog(load_json(live_lock_path()), ignore_patterns)
    skills = normalized["skills"]
    if not allow_removals:
        for name in sorted(existing.keys() - skills.keys()):
            if is_ignored(name, ignore_patterns):
                continue
            print(
                "would remove catalog skill without --allow-removals: "
                f"{name}; preserving"
            )
            skills[name] = existing[name]
    content = json.dumps({"skills": dict(sorted(skills.items()))}, indent=2) + "\n"
    if catalog.is_file() and catalog.read_text() == content:
        print("catalog unchanged")
        return
    catalog.write_text(content)
    print(f"catalog wrote {catalog}")


def shared_skills_root() -> pathlib.Path:
    return skill_state_paths().shared


def _ensure_cli_alias(native: pathlib.Path, resolved: pathlib.Path) -> None:
    if native.resolve(strict=False) == resolved.resolve(strict=False):
        return
    resolved.parent.mkdir(parents=True, exist_ok=True)
    native.parent.mkdir(parents=True, exist_ok=True)
    if native.is_symlink() and native.resolve(strict=False) == resolved.resolve(strict=False):
        return
    if native.exists() or native.is_symlink():
        raise ValueError(
            f"skills CLI path {native} does not match resolved path {resolved}"
        )
    native.symlink_to(resolved, target_is_directory=resolved.is_dir())


def prepare_cli_state() -> None:
    state = skill_state_paths()
    state.shared.mkdir(mode=0o700, parents=True, exist_ok=True)
    state.lock.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    home = pathlib.Path.home()
    _ensure_cli_alias(home / ".agents" / "skills", state.shared)
    _ensure_cli_alias(state.native_lock, state.lock)


def load_catalog(root: pathlib.Path) -> dict[str, dict[str, str]]:
    path = root / "skills-catalog.json"
    catalog = load_json(path)
    if not isinstance(catalog, dict) or set(catalog) != {"skills"}:
        raise ValueError(f"broken catalog: {path} must contain only a skills object")
    raw_skills = catalog["skills"]
    if not isinstance(raw_skills, dict):
        raise ValueError(f"broken catalog: skills must be an object in {path}")

    skills: dict[str, dict[str, str]] = {}
    if tuple(raw_skills) != tuple(sorted(raw_skills)):
        raise ValueError("broken catalog: skill names are not sorted")
    for name, entry in raw_skills.items():
        valid = (
            isinstance(name, str)
            and isinstance(entry, dict)
            and tuple(entry) == CATALOG_FIELDS
            and all(
                isinstance(entry[field], str) and entry[field]
                for field in CATALOG_FIELDS
            )
        )
        if not valid:
            raise ValueError(f"broken catalog entry: {name}")
        if entry["source"].startswith("-"):
            raise ValueError(f"broken catalog entry source starts with '-': {name}")
        skills[name] = entry
    return skills


def validation_problems(root: pathlib.Path, shared: pathlib.Path) -> list[str]:
    catalog = load_catalog(root)
    ignore_patterns = load_ignore_patterns(root)
    problems: list[str] = []
    for name in sorted(catalog):
        if is_ignored(name, ignore_patterns):
            continue
        skill_dir = shared / name
        if not skill_dir.is_dir():
            problems.append(f"missing catalog skill: {name}")
        elif not (skill_dir / "SKILL.md").is_file():
            problems.append(f"catalog skill has no SKILL.md: {name}")

    if not shared.is_dir():
        problems.append(f"missing shared skills directory: {shared}")
        return problems
    for entry in sorted(shared.iterdir(), key=lambda path: path.name):
        if entry.is_symlink() or not entry.is_dir():
            continue
        if is_ignored(entry.name, ignore_patterns):
            continue
        if not (entry / "SKILL.md").is_file():
            problems.append(f"installed skill folder has no SKILL.md: {entry.name}")
        elif entry.name not in catalog:
            problems.append(f"uncatalogued installed skill: {entry.name}")
    return problems


def check(root: pathlib.Path) -> int:
    problems = validation_problems(root, shared_skills_root())
    if problems:
        for problem in problems:
            print(problem)
        return 1
    count = len(load_catalog(root))
    print(f"catalog valid: {count} skills")
    return 0


def node_version_key(npx: pathlib.Path) -> tuple[int, ...]:
    match = re.fullmatch(r"v?(\d+(?:\.\d+)*)", npx.parent.parent.name)
    if not match:
        return ()
    return tuple(int(part) for part in match.group(1).split("."))


def versioned_tool_candidates(root: pathlib.Path, name: str) -> list[pathlib.Path]:
    return sorted(root.glob(f"*/bin/{name}"), key=node_version_key, reverse=True)


def resolve_node_tool(name: str) -> pathlib.Path:
    from_path = shutil.which(name)
    if from_path:
        return pathlib.Path(from_path)

    home = pathlib.Path.home()
    candidates: list[pathlib.Path] = []
    searched = [f"PATH={os.environ.get('PATH', '')}"]
    nvm_bin = os.environ.get("NVM_BIN")
    if nvm_bin:
        candidates.append(pathlib.Path(nvm_bin) / name)
    nvm_root = home / ".nvm" / "versions" / "node"
    searched.append(str(nvm_root / "*" / "bin" / name))
    candidates.extend(versioned_tool_candidates(nvm_root, name))
    mise_data = pathlib.Path(
        os.environ.get("MISE_DATA_DIR", home / ".local/share/mise")
    )
    mise_root = mise_data / "installs" / "node"
    searched.append(str(mise_root / "*" / "bin" / name))
    candidates.extend(versioned_tool_candidates(mise_root, name))
    asdf_data = pathlib.Path(os.environ.get("ASDF_DATA_DIR", home / ".asdf"))
    asdf_root = asdf_data / "installs" / "nodejs"
    searched.append(str(asdf_root / "*" / "bin" / name))
    candidates.extend(versioned_tool_candidates(asdf_root, name))
    candidates.append(home / ".bun" / "bin" / name)
    brew_prefix = os.environ.get("HOMEBREW_PREFIX")
    if brew_prefix:
        candidates.append(pathlib.Path(brew_prefix) / "bin" / name)
    candidates.append(home / ".linuxbrew" / "bin" / name)
    if platform.system() == "Linux":
        candidates.append(pathlib.Path("/home/linuxbrew/.linuxbrew/bin") / name)
    elif not brew_prefix:
        candidates.extend(
            (pathlib.Path("/opt/homebrew/bin") / name, pathlib.Path("/usr/local/bin") / name)
        )

    searched.extend(str(candidate) for candidate in candidates)
    for candidate in candidates:
        if candidate.is_file() and os.access(candidate, os.X_OK):
            return candidate
    raise FileNotFoundError(
        f"{name} not found; checked: " + ", ".join(dict.fromkeys(searched))
    )


def resolve_npx() -> pathlib.Path:
    return resolve_node_tool("npx")


def command_env(npx: pathlib.Path) -> dict[str, str]:
    node = resolve_node_tool("node")
    env = os.environ.copy()
    current_path = env.get("PATH", "")
    env["PATH"] = os.pathsep.join(
        part
        for part in dict.fromkeys(
            (str(npx.parent), str(node.parent), *current_path.split(os.pathsep))
        )
        if part
    )
    return env


def run_command(
    description: str,
    command: list[str],
    *,
    cwd: pathlib.Path,
    env: dict[str, str],
) -> None:
    print(description, flush=True)
    subprocess.run(command, cwd=cwd, env=env, check=True)


def generated_sync_commits(root: pathlib.Path, env: dict[str, str]) -> tuple[str, ...]:
    status = subprocess.run(
        ["git", "-C", str(root), "status", "--porcelain"],
        cwd=root,
        env=env,
        text=True,
        capture_output=True,
        check=True,
    ).stdout
    if status:
        return ()
    revisions = subprocess.run(
        ["git", "-C", str(root), "rev-list", "@{u}..HEAD"],
        cwd=root,
        env=env,
        text=True,
        capture_output=True,
        check=True,
    ).stdout.splitlines()
    if not revisions:
        return ()
    subjects: list[str] = []
    for revision in revisions:
        subject = subprocess.run(
            ["git", "-C", str(root), "show", "-s", "--format=%s", revision],
            cwd=root,
            env=env,
            text=True,
            capture_output=True,
            check=True,
        ).stdout.strip()
        changed = subprocess.run(
            [
                "git",
                "-C",
                str(root),
                "diff-tree",
                "--no-commit-id",
                "--name-only",
                "-r",
                revision,
            ],
            cwd=root,
            env=env,
            text=True,
            capture_output=True,
            check=True,
        ).stdout.splitlines()
        if not subject.startswith("chore(skills): sync") or changed != [
            "skills-catalog.json"
        ]:
            return ()
        subjects.append(subject)
    return tuple(subjects)


def upstream_has_remote_commits(root: pathlib.Path, env: dict[str, str]) -> bool:
    count = subprocess.run(
        ["git", "-C", str(root), "rev-list", "--count", "HEAD..@{u}"],
        cwd=root,
        env=env,
        text=True,
        capture_output=True,
        check=True,
    ).stdout.strip()
    return count != "0"


def recover_generated_sync_commits(
    root: pathlib.Path, env: dict[str, str], *, failure: str
) -> None:
    if not upstream_has_remote_commits(root, env):
        raise ValueError(f"{failure} failed without an upstream race; keeping local commits")
    if not generated_sync_commits(root, env):
        raise ValueError(
            f"refusing to discard non-sync local commits after {failure} failure"
        )
    run_command(
        "discard generated sync commits",
        ["git", "-C", str(root), "reset", "--hard", "@{u}"],
        cwd=root,
        env=env,
    )
    run_command(
        "git pull --ff-only",
        ["git", "-C", str(root), "pull", "--ff-only"],
        cwd=root,
        env=env,
    )


def normalize_and_commit(root: pathlib.Path, env: dict[str, str]) -> bool:
    catalog_path = root / "skills-catalog.json"
    original = catalog_path.read_bytes() if catalog_path.is_file() else None
    normalize(root)
    if check(root) != 0:
        raise ValueError("catalog validation failed")
    current = catalog_path.read_bytes()
    if original == current:
        print("catalog unchanged; no commit")
        return False
    run_command(
        "git add skills-catalog.json",
        ["git", "-C", str(root), "add", "skills-catalog.json"],
        cwd=root,
        env=env,
    )
    message = f"chore(skills): sync from {socket.gethostname()}"
    run_command(
        f"git commit: {message}",
        ["git", "-C", str(root), "commit", "-m", message],
        cwd=root,
        env=env,
    )
    return True


def install_missing(root: pathlib.Path) -> int:
    shared = shared_skills_root()
    shared.mkdir(mode=0o700, parents=True, exist_ok=True)
    shared.chmod(0o700)
    catalog = load_catalog(root)
    missing = [(name, entry) for name, entry in catalog.items() if not (shared / name / "SKILL.md").is_file()]
    if not missing:
        return 0
    prepare_cli_state()
    npx = resolve_npx()
    env = command_env(npx)
    failures: list[str] = []
    for name, entry in missing:
        try:
            run_command(
                f"install missing skill: {name} from {entry['source']}",
                [
                    str(npx),
                    "--yes",
                    "skills",
                    "add",
                    entry["source"],
                    "--skill",
                    name,
                    "-g",
                    "-y",
                ],
                cwd=pathlib.Path.home(),
                env=env,
            )
        except subprocess.CalledProcessError as error:
            failures.append(name)
            print(
                f"failed to install skill: {name} (exit {error.returncode})",
                file=sys.stderr,
            )
    if failures:
        noun = "skill" if len(failures) == 1 else "skills"
        print(
            f"failed to install {len(failures)} {noun}: {', '.join(failures)}",
            file=sys.stderr,
        )
        return 1
    return 0


def run(root: pathlib.Path, *, no_update: bool, no_push: bool) -> int:
    npx = resolve_npx()
    env = command_env(npx)
    try:
        run_command(
            "git pull --ff-only",
            ["git", "-C", str(root), "pull", "--ff-only"],
            cwd=root,
            env=env,
        )
    except subprocess.CalledProcessError:
        print("pull found only generated sync commits; recovering", flush=True)
        recover_generated_sync_commits(root, env, failure="pull")
    update_command = [str(root / "bin" / "skills-update")]
    if no_update:
        update_command.append("--no-update")
    run_command("sync installed skills", update_command, cwd=root, env=env)
    if not normalize_and_commit(root, env):
        return 0
    if no_push:
        print("push skipped: --no-push")
        return 0
    try:
        run_command(
            "git push",
            ["git", "-C", str(root), "push"],
            cwd=root,
            env=env,
        )
    except subprocess.CalledProcessError:
        run_command(
            "git fetch after rejected push",
            ["git", "-C", str(root), "fetch"],
            cwd=root,
            env=env,
        )
        print("push rejected; retrying sync once", flush=True)
        recover_generated_sync_commits(root, env, failure="push")
        if not normalize_and_commit(root, env):
            return 0
        run_command(
            "git push retry",
            ["git", "-C", str(root), "push"],
            cwd=root,
            env=env,
        )
    return 0


def schedule(root: pathlib.Path) -> None:
    npx = resolve_npx()
    node = resolve_node_tool("node")
    script = (root / "bin" / "skills-sync").resolve()
    schedule_path = os.pathsep.join(
        dict.fromkeys(
            (str(npx.parent), str(node.parent), "/usr/local/bin", "/usr/bin", "/bin")
        )
    )
    label = "com.impstack.skills-sync"
    state = skill_state_paths()
    schedule_environment = {
        "PATH": schedule_path,
        "HOME": str(pathlib.Path.home()),
        "SHARED_SKILLS": str(state.shared),
        "SKILLS_LOCK_FILE": str(state.lock),
    }
    if state.xdg_state_home:
        schedule_environment["XDG_STATE_HOME"] = str(state.xdg_state_home)
    minute = int.from_bytes(
        hashlib.sha256(socket.gethostname().encode()).digest()[:8], "big"
    ) % 60
    print("macOS launchd plist:")
    print(
        "\n".join(
            (
                '<?xml version="1.0" encoding="UTF-8"?>',
                '<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" '
                '"http://www.apple.com/DTDs/PropertyList-1.0.dtd">',
                '<plist version="1.0">',
                "<dict>",
                "  <key>Label</key>",
                f"  <string>{label}</string>",
                "  <key>ProgramArguments</key>",
                "  <array>",
                f"    <string>{escape(str(script))}</string>",
                "    <string>run</string>",
                "  </array>",
                "  <key>EnvironmentVariables</key>",
                "  <dict>",
                *(
                    line
                    for key, value in schedule_environment.items()
                    for line in (f"    <key>{key}</key>", f"    <string>{escape(value)}</string>")
                ),
                "  </dict>",
                "  <key>StartCalendarInterval</key>",
                "  <dict>",
                "    <key>Hour</key>",
                "    <integer>9</integer>",
                "    <key>Minute</key>",
                f"    <integer>{minute}</integer>",
                "  </dict>",
                "</dict>",
                "</plist>",
            )
        )
    )
    print("Linux crontab:")
    print(
        f"{minute} 9 * * * "
        + " ".join(f"{key}={shlex.quote(value)}" for key, value in schedule_environment.items())
        + " "
        f"{shlex.quote(str(script))} run"
    )


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    subparsers = parser.add_subparsers(dest="command", required=True)
    normalize_parser = subparsers.add_parser("normalize")
    normalize_parser.add_argument("--allow-removals", action="store_true")
    subparsers.add_parser("check")
    run_parser = subparsers.add_parser("run")
    run_parser.add_argument("--no-update", action="store_true")
    run_parser.add_argument("--no-push", action="store_true")
    subparsers.add_parser("schedule")
    subparsers.add_parser("install-missing", help="Restore absent catalog entries.")
    subparsers.add_parser("resolve-npx", help="Print the resolved npx executable.")
    subparsers.add_parser("resolve-node", help="Print the resolved node executable.")
    subparsers.add_parser("resolve-shared", help="Print the shared skills directory.")
    subparsers.add_parser("resolve-lock", help="Print the skills CLI lock file.")
    subparsers.add_parser("runtime-path", help="Print PATH with the Node runtime.")
    subparsers.add_parser("prepare-state", help="Align native skills CLI paths.")
    return parser.parse_args(argv)


def main(argv: list[str]) -> int:
    args = parse_args(argv)
    try:
        if args.command == "normalize":
            normalize(repo_root(), allow_removals=args.allow_removals)
            return 0
        if args.command == "check":
            return check(repo_root())
        if args.command == "schedule":
            schedule(repo_root())
            return 0
        if args.command == "install-missing":
            return install_missing(repo_root())
        if args.command == "resolve-npx":
            print(resolve_npx())
            return 0
        if args.command == "resolve-node":
            print(resolve_node_tool("node"))
            return 0
        if args.command == "resolve-shared":
            print(skill_state_paths().shared)
            return 0
        if args.command == "resolve-lock":
            print(skill_state_paths().lock)
            return 0
        if args.command == "runtime-path":
            print(command_env(resolve_npx())["PATH"])
            return 0
        if args.command == "prepare-state":
            prepare_cli_state()
            return 0
        if args.command == "run":
            return run(repo_root(), no_update=args.no_update, no_push=args.no_push)
        raise NotImplementedError(f"{args.command} is not implemented")
    except (
        FileNotFoundError,
        OSError,
        subprocess.CalledProcessError,
        ValueError,
    ) as error:
        print(f"error: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
